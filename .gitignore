# ==============================================================================
# 1. PYTHON & FASTAPI (BACKEND)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
.venv/
venv/


# Caches de testes, tipagem e linters
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Bancos de dados locais de desenvolvimento
*.db
*.sqlite
*.sqlite3

# ==============================================================================
# 2. REACT, VITE & NODE.JS (FRONTEND)
# ==============================================================================
node_modules/
dist/
dist-ssr/
build/
*.local
.npm
.eslintcache
*.tsbuildinfo

# ==============================================================================
# 3. VARIÁVEIS DE AMBIENTE E SEGREDOS
# ==============================================================================
.env
.env.*
!.env.example

# ==============================================================================
# 4. PROTEÇÃO DE PROPRIEDADE INTELECTUAL & ARQUIVOS TEMPORÁRIOS WORD/INPI
# ==============================================================================
# Ignora arquivos de lock/temporários que o LibreOffice criam ao abrir um .docx
~$*.docx
~$*.doc
.~lock.*

# Ignora pacotes e minutas geradas em testes locais para nunca vazar patentes no Git
Pacote_Minutas_*.zip
minuta_patente_*.docx
rascunho_patente_*.json
figuras_temp/
inpi_ephemeral_*/
patente_ephemeral_*/
output/
outputs/

# GARANTE que os templates oficiais em branco do laboratório NÃO sejam ignorados
!backend/templates/**/*.docx

# ==============================================================================
# 5. SISTEMA OPERACIONAL E EDITORES (LINUX / WINDOWS / VSCODE)
# ==============================================================================
.DS_Store
Thumbs.db
*~

# VS Code (ignora configurações locais da máquina, mas permite extensões recomendadas)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/


# arquivos especificos: 
002-rotas-da-api.md


# Dependências (nunca devem ir para o repositório)
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build de produção do Vite
dist/
frontend/dist/
dist-ssr/
*.local

# Logs de erro e execução de gerenciadores de pacote
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Variáveis de ambiente (podem conter credenciais ou URLs locais)

frontend/.env
frontend/.env.local

